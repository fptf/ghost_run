# Скопируйте в .env при необходимости. У всех значений есть умолчания в docker-compose.yml.
POSTGRES_USER=runners
POSTGRES_PASSWORD=runners
POSTGRES_DB=runners
S3_ACCESS_KEY=runners
S3_SECRET_KEY=runners-secret
S3_BUCKET=tracks

# Аутентификация
JWT_SECRET=dev-insecure-secret-change-me-0123456789
# Client ID из Google Cloud Console (см. README); пусто — работает только dev-вход
GOOGLE_CLIENT_ID=
# Dev-вход без Google — только для разработки, в проде false
AUTH_DEV_LOGIN=true

# Порты на хосте
POSTGRES_PORT=5432
REDIS_PORT=6379
S3_PORT=8333
API_PORT=8000
FRONTEND_PORT=5173

# Для запуска бэкенда без Docker (из backend/: uv run uvicorn app.main:app)
DATABASE_URL=postgresql+psycopg://runners:runners@localhost:5432/runners
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT_URL=http://localhost:8333
